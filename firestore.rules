rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function firstAdminNotCreated() {
      return !exists(/databases/$(database)/documents/appConfig/auth);
    }

    function role() {
      return signedIn() && userProfile(request.auth.uid).data.isActive == true
        && userProfile(request.auth.uid).data.isDeleted != true
        ? userProfile(request.auth.uid).data.role
        : 'Reader';
    }

    function isAdmin() {
      return role() == 'Admin';
    }

    function isContributor() {
      return role() == 'Contributor';
    }

    function isReader() {
      return role() == 'Reader';
    }

    function isSoftDelete() {
      return request.resource.data.isDeleted == true;
    }

    function noHardDelete() {
      return false;
    }

    function createsActiveRecord() {
      return request.resource.data.isDeleted != true;
    }

    function updatesActiveRecord() {
      return resource.data.isDeleted != true
        && request.resource.data.isDeleted != true;
    }

    function reactivatesOwnProfile(userId) {
      return request.auth.uid == userId
        && resource.data.isDeleted == true
        && request.resource.data.role == resource.data.role
        && request.resource.data.isDeleted == false
        && request.resource.data.isActive == true;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (firstAdminNotCreated() || request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && (
        (
          firstAdminNotCreated() &&
          request.auth.uid == userId &&
          request.resource.data.role == 'Admin' &&
          request.resource.data.isActive == true
        ) ||
        (
          request.auth.uid == userId &&
          !exists(/databases/$(database)/documents/users/$(userId)) &&
          request.resource.data.role == 'Reader'
        ) ||
        isAdmin()
      );
      allow update: if signedIn() && (
        isAdmin() ||
        reactivatesOwnProfile(userId) ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.isDeleted != true
        )
      );
      allow delete: if noHardDelete();
    }

    match /appConfig/auth {
      allow read: if signedIn();
      allow create: if signedIn()
        && firstAdminNotCreated()
        && request.resource.data.firstAdminUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /villas/{villaId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isAdmin();
      allow delete: if noHardDelete();
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isAdmin();
      allow delete: if noHardDelete();
    }

    match /incomes/{incomeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (isAdmin() || (isContributor() && createsActiveRecord()));
      allow update: if signedIn()
        && (isAdmin() || (isContributor() && updatesActiveRecord()));
      allow delete: if noHardDelete();
    }

    match /expenses/{expenseId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (isAdmin() || (isContributor() && createsActiveRecord()));
      allow update: if signedIn()
        && (isAdmin() || (isContributor() && updatesActiveRecord()));
      allow delete: if noHardDelete();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (isAdmin() || (isContributor() && createsActiveRecord()));
      allow update: if signedIn()
        && (isAdmin() || (isContributor() && updatesActiveRecord()));
      allow delete: if noHardDelete();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
