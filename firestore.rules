rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function firstAdminNotCreated() {
      return !exists(/databases/$(database)/documents/appConfig/auth);
    }

    function role() {
      return signedIn() && userProfile(request.auth.uid).data.isActive == true
        && userProfile(request.auth.uid).data.isDeleted != true
        ? userProfile(request.auth.uid).data.role
        : 'Reader';
    }

    function isAdmin() {
      return role() == 'Admin';
    }

    function isSuperAdmin() {
      return role() == 'SuperAdmin';
    }

    function isContributor() {
      return role() == 'Contributor';
    }

    function isReader() {
      return role() == 'Reader';
    }

    function userOrgId() {
      return userProfile(request.auth.uid).data.orgId;
    }

    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(uid);
    }

    function hasActiveMembership(orgId) {
      return signedIn()
        && exists(memberPath(orgId, request.auth.uid))
        && get(memberPath(orgId, request.auth.uid)).data.status == 'Active';
    }

    function memberRole(orgId) {
      return hasActiveMembership(orgId)
        ? get(memberPath(orgId, request.auth.uid)).data.role
        : 'Reader';
    }

    function isOrgAdmin(orgId) {
      return memberRole(orgId) == 'Admin';
    }

    function isOrgContributor(orgId) {
      return memberRole(orgId) == 'Contributor';
    }

    function sameOrgOnExisting() {
      return hasActiveMembership(resource.data.orgId);
    }

    function sameOrgOnRequest() {
      return hasActiveMembership(request.resource.data.orgId);
    }

    function sameOrg() {
      return sameOrgOnExisting() && sameOrgOnRequest();
    }

    function isSoftDelete() {
      return request.resource.data.isDeleted == true;
    }

    function isOrganizationRole(roleValue) {
      return roleValue in ['Admin', 'Contributor', 'Reader'];
    }

    function isSuperAdminProfile() {
      return request.resource.data.role == 'SuperAdmin'
        && (!request.resource.data.keys().hasAny(['orgId']) || request.resource.data.orgId == null);
    }

    function isOrganizationProfile() {
      return isOrganizationRole(request.resource.data.role)
        && request.resource.data.orgId is string
        && request.resource.data.orgId.size() > 0;
    }

    function noHardDelete() {
      return false;
    }

    function canHardDeleteSoftDeleted() {
      return signedIn()
        && isSuperAdmin()
        && resource.data.isDeleted == true;
    }

    function createsActiveRecord() {
      return request.resource.data.isDeleted != true;
    }

    function updatesActiveRecord() {
      return resource.data.isDeleted != true
        && request.resource.data.isDeleted != true;
    }

    function reactivatesOwnProfile(userId) {
      return request.auth.uid == userId
        && resource.data.isDeleted == true
        && request.resource.data.role == resource.data.role
        && request.resource.data.isDeleted == false
        && request.resource.data.isActive == true;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (
          firstAdminNotCreated() ||
          request.auth.uid == userId ||
          isSuperAdmin() ||
          hasActiveMembership(resource.data.orgId) ||
          (hasActiveMembership(resource.data.orgId) && isOrgAdmin(resource.data.orgId))
        );
      allow create: if signedIn() && (
        (
          firstAdminNotCreated() &&
          request.auth.uid == userId &&
          request.resource.data.role == 'Admin' &&
          request.resource.data.isActive == true
        ) ||
        (
          request.auth.uid == userId &&
          !exists(/databases/$(database)/documents/users/$(userId)) &&
          request.resource.data.role == 'Reader'
        ) ||
        (isSuperAdmin() &&
          (
            isSuperAdminProfile() ||
            isOrganizationProfile()
          )
        ) ||
        (
          sameOrgOnRequest() &&
          isOrgAdmin(request.resource.data.orgId) &&
          isOrganizationRole(request.resource.data.role)
        )
      );
      allow update: if signedIn() && (
        (
          isSuperAdmin() &&
          (
            isSuperAdminProfile() ||
            isOrganizationProfile()
          )
        ) ||
        (
          sameOrg() &&
          isOrgAdmin(resource.data.orgId) &&
          resource.data.role != 'SuperAdmin' &&
          isOrganizationRole(request.resource.data.role)
        ) ||
        reactivatesOwnProfile(userId) ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.orgId == resource.data.orgId &&
          request.resource.data.isDeleted != true
        )
      );
      allow delete: if noHardDelete();
    }

    match /appConfig/auth {
      allow read: if signedIn();
      allow create: if signedIn()
        && firstAdminNotCreated()
        && request.resource.data.firstAdminUid == request.auth.uid;
      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    match /organizations/{orgId} {
      allow read: if signedIn()
        && (isSuperAdmin() || hasActiveMembership(orgId));
      allow create, update: if signedIn() && isSuperAdmin();
      allow delete: if noHardDelete();

      match /members/{memberId} {
        allow read: if signedIn()
          && (
            isSuperAdmin() ||
            request.auth.uid == memberId ||
            (hasActiveMembership(orgId) && isOrgAdmin(orgId))
          );
        allow create: if signedIn()
          && (
            isSuperAdmin() ||
            (hasActiveMembership(orgId) &&
              isOrgAdmin(orgId) &&
              request.resource.data.uid == memberId &&
              request.resource.data.status in ['Pending', 'Active'] &&
              isOrganizationRole(request.resource.data.role))
          );
        allow update: if signedIn()
          && (
            isSuperAdmin() ||
            (hasActiveMembership(orgId) &&
              isOrgAdmin(orgId) &&
              resource.data.role != 'SuperAdmin' &&
              request.resource.data.uid == resource.data.uid &&
              isOrganizationRole(request.resource.data.role))
          );
        allow delete: if noHardDelete();
      }
    }

    match /villas/{villaId} {
      allow read: if signedIn() && (isSuperAdmin() || sameOrgOnExisting());
      allow create: if signedIn()
        && (isSuperAdmin() || (sameOrgOnRequest() && isOrgAdmin(request.resource.data.orgId)));
      allow update: if signedIn()
        && (isSuperAdmin() || (sameOrg() && isOrgAdmin(resource.data.orgId)));
      allow delete: if canHardDeleteSoftDeleted();
    }

    match /rooms/{roomId} {
      allow read: if signedIn() && (isSuperAdmin() || sameOrgOnExisting());
      allow create: if signedIn()
        && (isSuperAdmin() || (sameOrgOnRequest() && isOrgAdmin(request.resource.data.orgId)));
      allow update: if signedIn()
        && (isSuperAdmin() || (sameOrg() && isOrgAdmin(resource.data.orgId)));
      allow delete: if canHardDeleteSoftDeleted();
    }

    match /incomes/{incomeId} {
      allow read: if signedIn() && (isSuperAdmin() || sameOrgOnExisting());
      allow create: if signedIn()
        && (
          isSuperAdmin() ||
          ((isOrgAdmin(request.resource.data.orgId) || isOrgContributor(request.resource.data.orgId)) && sameOrgOnRequest() && createsActiveRecord())
        );
      allow update: if signedIn()
        && (
          isSuperAdmin() ||
          ((isOrgAdmin(resource.data.orgId) || isOrgContributor(resource.data.orgId)) && sameOrg() && updatesActiveRecord())
        );
      allow delete: if canHardDeleteSoftDeleted();
    }

    match /expenses/{expenseId} {
      allow read: if signedIn() && (isSuperAdmin() || sameOrgOnExisting());
      allow create: if signedIn()
        && (
          isSuperAdmin() ||
          ((isOrgAdmin(request.resource.data.orgId) || isOrgContributor(request.resource.data.orgId)) && sameOrgOnRequest() && createsActiveRecord())
        );
      allow update: if signedIn()
        && (
          isSuperAdmin() ||
          ((isOrgAdmin(resource.data.orgId) || isOrgContributor(resource.data.orgId)) && sameOrg() && updatesActiveRecord())
        );
      allow delete: if canHardDeleteSoftDeleted();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (isSuperAdmin() || sameOrgOnExisting());
      allow create: if signedIn()
        && (
          isSuperAdmin() ||
          ((isOrgAdmin(request.resource.data.orgId) || isOrgContributor(request.resource.data.orgId)) && sameOrgOnRequest() && createsActiveRecord())
        );
      allow update: if signedIn()
        && (
          isSuperAdmin() ||
          ((isOrgAdmin(resource.data.orgId) || isOrgContributor(resource.data.orgId)) && sameOrg() && updatesActiveRecord())
        );
      allow delete: if canHardDeleteSoftDeleted();
    }

    match /room_media/{mediaId} {
      allow read: if signedIn() && (isSuperAdmin() || sameOrgOnExisting());
      allow create: if signedIn()
        && (
          isSuperAdmin() ||
          ((isOrgAdmin(request.resource.data.orgId) || isOrgContributor(request.resource.data.orgId)) && sameOrgOnRequest() && createsActiveRecord())
        )
        && !request.resource.data.keys().hasAny(['localPath'])
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.size() > 0
        && request.resource.data.downloadUrl is string
        && request.resource.data.downloadUrl.size() > 0
        && request.resource.data.syncStatus == 'synced';
      allow update: if signedIn()
        && (
          isSuperAdmin() ||
          ((isOrgAdmin(resource.data.orgId) || isOrgContributor(resource.data.orgId)) && sameOrg() && updatesActiveRecord())
        )
        && !request.resource.data.keys().hasAny(['localPath']);
      allow delete: if canHardDeleteSoftDeleted();
    }

    match /tenant_history/{historyId} {
      allow read: if signedIn()
        && (isSuperAdmin() || sameOrgOnExisting());
      allow create, update: if false;
      allow delete: if canHardDeleteSoftDeleted();
    }

    match /app_logs/{logId} {
      allow read: if signedIn() && isSuperAdmin();
      allow create, update: if false;
      allow delete: if canHardDeleteSoftDeleted();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
