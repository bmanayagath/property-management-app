rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function firstAdminNotCreated() {
      return !exists(/databases/$(database)/documents/appConfig/auth);
    }

    function role() {
      return signedIn() && userProfile(request.auth.uid).data.isActive == true
        && userProfile(request.auth.uid).data.isDeleted != true
        ? userProfile(request.auth.uid).data.role
        : 'Reader';
    }

    function isAdmin() {
      return role() == 'Admin';
    }

    function isSuperAdmin() {
      return role() == 'SuperAdmin';
    }

    function isContributor() {
      return role() == 'Contributor';
    }

    function isReader() {
      return role() == 'Reader';
    }

    function userOrgId() {
      return userProfile(request.auth.uid).data.orgId;
    }

    function sameOrgOnExisting() {
      return resource.data.orgId == userOrgId();
    }

    function sameOrgOnRequest() {
      return request.resource.data.orgId == userOrgId();
    }

    function sameOrg() {
      return sameOrgOnExisting() && sameOrgOnRequest();
    }

    function isSoftDelete() {
      return request.resource.data.isDeleted == true;
    }

    function noHardDelete() {
      return false;
    }

    function createsActiveRecord() {
      return request.resource.data.isDeleted != true;
    }

    function updatesActiveRecord() {
      return resource.data.isDeleted != true
        && request.resource.data.isDeleted != true;
    }

    function reactivatesOwnProfile(userId) {
      return request.auth.uid == userId
        && resource.data.isDeleted == true
        && request.resource.data.role == resource.data.role
        && request.resource.data.isDeleted == false
        && request.resource.data.isActive == true;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (
          firstAdminNotCreated() ||
          request.auth.uid == userId ||
          isSuperAdmin() ||
          (isAdmin() && resource.data.orgId == userOrgId())
        );
      allow create: if signedIn() && (
        (
          firstAdminNotCreated() &&
          request.auth.uid == userId &&
          request.resource.data.role == 'Admin' &&
          request.resource.data.isActive == true
        ) ||
        (
          request.auth.uid == userId &&
          !exists(/databases/$(database)/documents/users/$(userId)) &&
          request.resource.data.role == 'Reader'
        ) ||
        isSuperAdmin() ||
        (isAdmin() && sameOrgOnRequest())
      );
      allow update: if signedIn() && (
        isSuperAdmin() ||
        (isAdmin() && sameOrg()) ||
        reactivatesOwnProfile(userId) ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.orgId == resource.data.orgId &&
          request.resource.data.isDeleted != true
        )
      );
      allow delete: if noHardDelete();
    }

    match /appConfig/auth {
      allow read: if signedIn();
      allow create: if signedIn()
        && firstAdminNotCreated()
        && request.resource.data.firstAdminUid == request.auth.uid;
      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    match /organizations/{orgId} {
      allow read: if signedIn()
        && (isSuperAdmin() || orgId == userOrgId());
      allow create, update: if signedIn() && isSuperAdmin();
      allow delete: if noHardDelete();
    }

    match /villas/{villaId} {
      allow read: if signedIn() && (isSuperAdmin() || sameOrgOnExisting());
      allow create: if signedIn()
        && (isSuperAdmin() || (isAdmin() && sameOrgOnRequest()));
      allow update: if signedIn()
        && (isSuperAdmin() || (isAdmin() && sameOrg()));
      allow delete: if noHardDelete();
    }

    match /rooms/{roomId} {
      allow read: if signedIn() && (isSuperAdmin() || sameOrgOnExisting());
      allow create: if signedIn()
        && (isSuperAdmin() || (isAdmin() && sameOrgOnRequest()));
      allow update: if signedIn()
        && (isSuperAdmin() || (isAdmin() && sameOrg()));
      allow delete: if noHardDelete();
    }

    match /incomes/{incomeId} {
      allow read: if signedIn() && (isSuperAdmin() || sameOrgOnExisting());
      allow create: if signedIn()
        && (
          isSuperAdmin() ||
          ((isAdmin() || isContributor()) && sameOrgOnRequest() && createsActiveRecord())
        );
      allow update: if signedIn()
        && (
          isSuperAdmin() ||
          ((isAdmin() || isContributor()) && sameOrg() && updatesActiveRecord())
        );
      allow delete: if noHardDelete();
    }

    match /expenses/{expenseId} {
      allow read: if signedIn() && (isSuperAdmin() || sameOrgOnExisting());
      allow create: if signedIn()
        && (
          isSuperAdmin() ||
          ((isAdmin() || isContributor()) && sameOrgOnRequest() && createsActiveRecord())
        );
      allow update: if signedIn()
        && (
          isSuperAdmin() ||
          ((isAdmin() || isContributor()) && sameOrg() && updatesActiveRecord())
        );
      allow delete: if noHardDelete();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (isSuperAdmin() || sameOrgOnExisting());
      allow create: if signedIn()
        && (
          isSuperAdmin() ||
          ((isAdmin() || isContributor()) && sameOrgOnRequest() && createsActiveRecord())
        );
      allow update: if signedIn()
        && (
          isSuperAdmin() ||
          ((isAdmin() || isContributor()) && sameOrg() && updatesActiveRecord())
        );
      allow delete: if noHardDelete();
    }

    match /room_media/{mediaId} {
      allow read: if signedIn() && (isSuperAdmin() || sameOrgOnExisting());
      allow create: if signedIn()
        && (
          isSuperAdmin() ||
          ((isAdmin() || isContributor()) && sameOrgOnRequest() && createsActiveRecord())
        )
        && !request.resource.data.keys().hasAny(['localPath'])
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.size() > 0
        && request.resource.data.downloadUrl is string
        && request.resource.data.downloadUrl.size() > 0
        && request.resource.data.syncStatus == 'synced';
      allow update: if signedIn()
        && (
          isSuperAdmin() ||
          ((isAdmin() || isContributor()) && sameOrg() && updatesActiveRecord())
        )
        && !request.resource.data.keys().hasAny(['localPath']);
      allow delete: if noHardDelete();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
